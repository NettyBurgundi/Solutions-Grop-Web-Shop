let count = 0;
function addToCart(name){
  count++;
  document.getElementById('cartCount').textContent = count;
  alert(name + ' wurde zum Warenkorb hinzugefügt!\nWarenkorb: ' + count + ' Artikel');
}
document.addEventListener('DOMContentLoaded', ()=>{
  const form = document.getElementById('kontaktForm');
  if(form){
    form.addEventListener('submit', (e)=>{
      e.preventDefault();
      const name = document.getElementById('name').value;
      document.getElementById('danke').style.display='block';
      document.getElementById('danke').innerHTML = 'Danke, ' + name + '! Deine Nachricht wurde gesendet. Wir melden uns innerhalb von 24 Stunden.';
      form.reset();
    });
  }
});
