:root{ --main:#88979f; --dark:#31342f; --green:#666e5d; --light:#f2f3f1; }
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,Helvetica,sans-serif;background:var(--light);color:var(--dark);line-height:1.6}
header{background:white;padding:10px 0;box-shadow:0 2px 10px rgba(0,0,0,.08)}
.nav{max-width:1100px;margin:auto;display:flex;justify-content:space-between;align-items:center;padding:0 20px;flex-wrap:wrap}
.header-logo{height:75px;width:auto}
nav a{color:var(--dark);text-decoration:none;margin-left:18px;font-weight:bold}
nav a:hover{color:var(--main)}
.hero{background:var(--dark);color:white;padding:50px 20px;text-align:center}
.hero h1{font-size:38px;margin-bottom:10px}
.hero p{max-width:700px;margin:10px auto}
.btn{display:inline-block;background:var(--green);color:white;padding:12px 22px;border-radius:8px;text-decoration:none;font-weight:bold;margin-top:12px;border:none;cursor:pointer}
.btn:hover{opacity:.9}
.container{max-width:1100px;margin:auto;padding:30px 20px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
.card{background:white;border-radius:12px;overflow:hidden;box-shadow:0 4px 14px rgba(0,0,0,.08)}
.card img{width:100%;height:180px;object-fit:cover}
.card-body{padding:18px}
.price{font-weight:900;font-size:19px;color:var(--green);margin:10px 0}
.tag{display:inline-block;background:var(--main);color:white;padding:4px 10px;border-radius:20px;font-size:12px}
.hero-img{width:100%;max-height:420px;object-fit:cover;border-radius:12px;margin-bottom:20px}
.buero-img{width:100%;max-height:380px;object-fit:cover;border-radius:12px;margin-top:20px}
footer{background:var(--dark);color:white;text-align:center;padding:20px;margin-top:30px}
form{max-width:600px;background:white;padding:22px;border-radius:12px}
label{display:block;margin-top:14px;font-weight:bold}
input,textarea,select{width:100%;padding:11px;border:1px solid #ccc;border-radius:8px;margin-top:6px}
.cart-badge{background:var(--green);color:white;padding:2px 8px;border-radius:20px}
#danke{display:none;background:#e6f0e6;border:2px solid var(--green);padding:16px;border-radius:10px;margin-top:18px}

